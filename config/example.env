# Copy to the project root:  cp config/example.env .env
# Then replace WEBHOOK_SECRET with the output of:  openssl rand -hex 32
# Local demo values only. Never put production credentials in this file.

HOST=127.0.0.1
PORT=3000
WEBHOOK_SECRET=replace-me
WEBHOOK_TOLERANCE_SECONDS=300
DB_PATH=data/leads.db

# Simulated CRM (runs locally inside the app process when START_MOCK_CRM=true)
CRM_BASE_URL=http://127.0.0.1:4010
CRM_API_KEY=local-mock-crm-key
CRM_TIMEOUT_MS=5000
START_MOCK_CRM=true
MOCK_CRM_PORT=4010
# ok | fail-500 | fail-429 | fail-400 | timeout
MOCK_CRM_MODE=ok

LOG_LEVEL=info

# Durable retries: attempts include the first one; delay = base * 2^(attempt-1), jittered, capped
RETRY_MAX_ATTEMPTS=6
RETRY_BASE_DELAY_MS=2000
RETRY_MAX_DELAY_MS=300000
# A lead stuck in "processing" longer than this (crash) is retried. Must exceed CRM_TIMEOUT_MS.
LEASE_MS=30000
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=5

# Simulated follow-up ("call the lead back") after a successful CRM sync. 15 min is realistic;
# use e.g. 10000 for a quick demo. No message is ever sent.
FOLLOW_UP_DELAY_MS=900000
